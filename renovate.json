{
  "$schema": "https://renovatebot.com",
  "dependencyDashboard": {
    "enabled": true
  },
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    "security:minimumReleaseAgeNpm",
    "group:stylelint",
    "group:postcss",
    "group:jsUnitTest"
  ],
  "packageRules": [
    {
      "extends": ["packages:eslint"],
      "groupName": "eslint packages",
      "groupSlug": "eslint",
      "separateMajorMinor": false
    }
  ],
  "platformAutomerge": true,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
